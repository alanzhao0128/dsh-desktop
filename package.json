{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.1",
  "description": "Native desktop shell for DeepSeek Harness: spawns `npx @deepseek-ai/dsh web` and embeds http://127.0.0.1:3080 in an Electron window.",
  "author": "dsh-desktop contributors",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "node scripts/smoke.js",
    "pack:mac": "electron-builder --mac",
    "pack:mac:dir": "electron-builder --mac dir",
    "pack:mac:dmg": "bash scripts/make-dmg.sh"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}
